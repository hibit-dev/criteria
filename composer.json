{
    "name": "hibit-dev/criteria",
    "type": "library",
    "description": "A comprehensive package for managing criteria pattern in PHP projects, streamlining data filtering, sorting, and pagination with ease.",
    "homepage": "https://www.hibit.dev",
    "license": "MIT",
    "keywords": [
        "filters",
        "repository",
        "criteria",
        "pagination",
        "sorting",
        "laravel",
        "symfony"
    ],
    "authors": [
        {
            "name": "Tigran Mekinyan",
            "email": "tmekinyan@mail.ru"
        }
    ],
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Hibit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Tests\\Helpers\\": "tests/_support"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse -c phpstan.neon",
        "test": "vendor/bin/phpunit tests",
        "test-coverage": "vendor/bin/phpunit tests --coverage-html reports/ --coverage-clover=coverage.xml"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
